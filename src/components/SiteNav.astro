---
const { siteTitle } = Astro.props;

const navLinks = [
    { label: "Home", uri: "/" },
    { label: "Blog", uri: "/blog" },
    { label: "About", uri: "/about" },
];
---

<header>
    <div><a href="/" class='site-name'>{siteTitle}</a></div>
    <div class="hamburger">&#9776;</div>
    <nav>
        <ul>
        {navLinks.map(link => {
            return (<li>
                        <a href={link.uri}>{link.label}</a>
                    </li>)
            })}
        </ul>
    </nav>
</header>
